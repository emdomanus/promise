--!nocheck

local loadPromise = require("./lib/loadPromise")
local cases = 0
local function test(name, callback)
	callback()
	cases += 1
	print("PASS " .. name)
end
local function assertNoLists(promise)
	assert(promise._callbacks == nil and promise._errbacks == nil)
	assert(promise._waiters == nil and promise._cancelHandlers == nil)
end

for _, codegenEnabled in { false, true } do
	local Promise = loadPromise(codegenEnabled)
	print(`Allocation checks: native={codegenEnabled}`)
	test("pending construction defers each subscription list until needed", function()
		local bind
		local promise = Promise.new(function(_, _, onCancel)
			bind = onCancel
		end)
		assertNoLists(promise)
		promise:andThen(function() end)
		assert(#promise._callbacks == 1 and promise._errbacks == nil and promise._waiters == nil)
		promise:catch(function() end)
		assert(#promise._errbacks == 1 and promise._cancelHandlers == nil)
		bind(function() end)
		assert(#promise._cancelHandlers == 1 and promise._waiters == nil)
		local resumed = false
		local waiter = coroutine.create(function()
			resumed = not pcall(function()
				promise:await()
			end)
		end)
		assert(coroutine.resume(waiter))
		assert(#promise._waiters == 1)
		promise:cancel()
		assert(resumed and coroutine.status(waiter) == "dead")
		assertNoLists(promise)
	end)

	test("resolution preserves nested observer and waiter ordering and releases lists", function()
		local finish
		local promise = Promise.new(function(resolve)
			finish = resolve
		end)
		local order = {}
		promise:andThen(function(value)
			assert(value == 42 and promise:isResolved())
			table.insert(order, "first")
			promise:andThen(function(nestedValue)
				assert(nestedValue == 42)
				table.insert(order, "nested")
			end)
			promise:cancel()
		end)
		promise:andThen(function()
			table.insert(order, "second")
		end)
		local waiter = coroutine.create(function()
			assert(promise:await() == 42)
			table.insert(order, "waiter")
		end)
		assert(coroutine.resume(waiter))
		finish(42)
		assert(table.concat(order, ",") == "first,nested,second,waiter")
		assertNoLists(promise)
		finish(100)
		assert(promise:await() == 42)
	end)

	test("rejection preserves nested observers and waiter error identity and releases lists", function()
		local finish
		local promise = Promise.new(function(_, reject)
			finish = reject
		end)
		local reason = {}
		local order = {}
		promise:catch(function(err)
			assert(err == reason)
			table.insert(order, "first")
			promise:catch(function(nestedError)
				assert(nestedError == reason)
				table.insert(order, "nested")
			end)
		end)
		promise:catch(function()
			table.insert(order, "second")
		end)
		local waiter = coroutine.create(function()
			local ok, err = pcall(function()
				return promise:await()
			end)
			assert(not ok and err == reason)
			table.insert(order, "waiter")
		end)
		assert(coroutine.resume(waiter))
		finish(reason)
		assert(table.concat(order, ",") == "first,nested,second,waiter")
		assertNoLists(promise)
	end)

	test("cancellation permits immediate nested binding and releases lists", function()
		local bind
		local order = {}
		local promise = Promise.new(function(_, _, onCancel)
			bind = onCancel
			onCancel(function()
				table.insert(order, "first")
				onCancel(function()
					table.insert(order, "nested")
				end)
			end)
			onCancel(function()
				table.insert(order, "second")
			end)
		end)
		promise:cancel()
		bind(function()
			table.insert(order, "late")
		end)
		assert(table.concat(order, ",") == "first,nested,second,late")
		assertNoLists(promise)
	end)

	test("settled factories preserve values errors and terminal behavior without lists", function()
		for _, value in { false, 0, "", {} } do
			local promise = Promise.resolve(value)
			assert(promise:isResolved() and not promise:isPending() and not promise:isRejected())
			assert(promise:await() == value)
			assert(promise:andThen(function(seen)
				assert(seen == value)
			end) == promise)
			promise:catch(function()
				error("resolved promise called rejection observer")
			end)
			promise:cancel()
			assert(not promise:isCancelled())
			assertNoLists(promise)
		end
		local nilPromise = Promise.resolve(nil)
		assert(nilPromise:isResolved() and nilPromise:await() == nil)
		assertNoLists(nilPromise)
		local reason = {}
		local rejected = Promise.reject(reason)
		assert(rejected:isRejected() and not rejected:isPending() and not rejected:isResolved())
		assert(rejected:catch(function(err)
			assert(err == reason)
		end) == rejected)
		rejected:andThen(function()
			error("rejected promise called success observer")
		end)
		local ok, err = pcall(function()
			return rejected:await()
		end)
		assert(not ok and err == reason)
		rejected:cancel()
		assert(not rejected:isCancelled())
		assertNoLists(rejected)
	end)
end

print(`Promise allocation: {cases} cases passed`)
